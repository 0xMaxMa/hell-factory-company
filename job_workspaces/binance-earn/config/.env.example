# ============================================================
# Binance Auto-Earn Bot — Environment Configuration
# ============================================================
# Copy this file to config/.env and fill in your values.
# NEVER commit config/.env to version control.
# ============================================================

# ── Binance API Credentials ──────────────────────────────────
# Create at: https://www.binance.com/en/my/settings/api-management
# Required permissions:
#   - Enable Reading
#   - Enable Spot & Margin Trading
# Recommended: IP whitelist restriction for security

BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here

# ── Optional: Binance.US (US users) ──────────────────────────
# Uncomment and set if using Binance.US instead of Binance global
# BINANCE_BASE_URL=https://api.binance.us

# ── Bot Behavior Settings ─────────────────────────────────────
# Target assets to monitor (comma-separated, used by scheduler/cron)
TARGET_ASSETS=USDT,USDC,BNB

# Minimum APY improvement required before rebalancing (decimal)
# 0.005 = must gain at least 0.5 percentage points to rebalance
MIN_REBALANCE_APY_DIFF=0.005

# Minimum APY threshold — do not subscribe if best APY is below this
# 0.02 = 2% minimum annual return
MIN_APY_THRESHOLD=0.02

# ── Notification (optional) ───────────────────────────────────
# Telegram bot token for trade notifications (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
