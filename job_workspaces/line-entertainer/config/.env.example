# =============================================================================
# LINE Entertainer Bot — Environment Configuration
# =============================================================================
# Copy this file to config/.env and fill in your real values.
# NEVER commit config/.env to version control!
#
# Get these from: https://developers.line.biz/console/
# =============================================================================

# --- LINE Messaging API Credentials (REQUIRED) ---

# Channel Secret — from LINE Developers Console > Basic Settings
LINE_CHANNEL_SECRET=your_channel_secret_here

# Channel Access Token — from LINE Developers Console > Messaging API > Issue Token
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# --- Server Configuration (OPTIONAL) ---

# Port for Flask webhook server (default: 5000)
PORT=5000

# Flask debug mode — set to false in production
FLASK_DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Optional: Bot Identity ---

# Default bot display name (used in messages when persona name not set)
BOT_DEFAULT_NAME=Nong Bot

# --- Optional: External APIs (for advanced features) ---

# OpenAI API key — for AI-powered natural conversation (optional)
# OPENAI_API_KEY=sk-...

# OpenWeatherMap — for weather replies (optional)
# WEATHER_API_KEY=your_weather_api_key_here

# --- Notes ---
# Webhook URL must be HTTPS in production.
# For local testing, use ngrok: https://ngrok.com/
# LINE free tier: 1000 push messages/month (reply messages are unlimited)
