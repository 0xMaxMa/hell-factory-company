# ============================================================
# Shopee CS Bot — Environment Variables
# Copy this file to config/.env and fill in real values
# ============================================================

# --- Shopee Open Platform Credentials ---
# Get from: https://open.shopee.com/ → My Apps → App Info

# Your app's Partner ID (integer)
SHOPEE_PARTNER_ID=your_partner_id_here

# Your app's Partner Key (secret key for HMAC-SHA256 signature)
SHOPEE_PARTNER_KEY=your_partner_key_here

# The Shop ID of the authorized seller account (integer)
SHOPEE_SHOP_ID=your_shop_id_here

# OAuth Access Token (valid 4 hours — bot auto-refreshes)
SHOPEE_ACCESS_TOKEN=your_access_token_here

# OAuth Refresh Token (valid 90 days — used to renew access_token)
SHOPEE_REFRESH_TOKEN=your_refresh_token_here

# --- Bot Behaviour ---

# Use sandbox/test environment instead of production (true/false)
SHOPEE_TEST_MODE=false

# How often to poll for new messages (seconds)
POLL_INTERVAL_SECONDS=60

# Enable auto-reply (true = send replies, false = log only, no send)
AUTO_REPLY_ENABLED=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
